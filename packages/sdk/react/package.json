{
  "name": "@thesolidchain/sdk-react",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "tsc -w",
    "test": "jest --passWithNoTests",
    "testw": "jest --watch",
    "build": "tsc -b --preserveWatchOutput -v tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@thesolidchain/protocol-plugins": "workspace:*",
    "@thesolidchain/sdk-client": "workspace:*",
    "@thesolidchain/sdk-common": "workspace:*"
  },
  "devDependencies": {
    "@thesolidchain/eslint-config": "workspace:*",
    "@thesolidchain/config-jest": "workspace:*",
    "@thesolidchain/testing-utils": "workspace:*",
    "@thesolidchain/config-typescript": "workspace:*",
    "@types/react": "^19.0.8"
  },
  "peerDependencies": {
    "react": "19.2.3"
  }
}
