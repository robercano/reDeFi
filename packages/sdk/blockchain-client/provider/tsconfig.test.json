{
  "extends": "@thesolidchain/config-typescript/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/configuration-provider": [
        "../../configuration-provider/service/service/src/index.ts"
      ],
      "@thesolidchain/configuration-provider-common": [
        "node_modules/@thesolidchain/configuration-provider-common/src/index.ts"
      ],
      "@thesolidchain/testing-utils": ["node_modules/@thesolidchain/testing-utils/src/index.ts"],
      "@thesolidchain/testing-utils/*": ["node_modules/@thesolidchain/testing-utils/src/*"],
      "@thesolidchain/serverless-shared/*": ["node_modules/@thesolidchain/serverless-shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
