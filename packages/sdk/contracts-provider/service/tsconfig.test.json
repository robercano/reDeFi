{
  "extends": "@thesolidchain/config-typescript/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/blockchain-client-provider": [
        "node_modules/@thesolidchain/blockchain-client-provider/src"
      ],
      "@thesolidchain/serverless-shared/*": ["../../packages/serverless-shared/src/*"],
      "@thesolidchain/configuration-provider": ["../../configuration-provider/service/service/src"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src"],
      "@thesolidchain/tenderly-utils": ["node_modules/@thesolidchain/tenderly-utils/src"],
      "@thesolidchain/testing-utils/*": ["node_modules/@thesolidchain/testing-utils/src/*"],
      "@thesolidchain/testing-utils": ["node_modules/@thesolidchain/testing-utils/src"],
      "@thesolidchain/protocol-plugins-common": [
        "../../protocol-plugins/service/service-common/src"
      ],
      "@thesolidchain/api-server-common": ["../../sdk-server/service/service-common/src"],
      "@thesolidchain/tokens-service": ["node_modules/@thesolidchain/tokens-service/src"],
      "@thesolidchain/contracts-provider-common": [
        "node_modules/@thesolidchain/contracts-provider-common/src"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
