{
  "name": "@thesolidchain/protocol-plugins",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    },
    "./*": {
      "import": "./src/*/index.ts",
      "types": "./src/*/index.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "tsc -w",
    "test": "vitest run tests/unit",
    "testw": "vitest tests/unit",
    "test:integration": "vitest run tests/integration",
    "testw:integration": "vitest tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -b --preserveWatchOutput -v tsconfig.build.json",
    "declarations": "tsc --emitDeclarationOnly -p tsconfig.bundle.json"
  },
  "dependencies": {
    "@thesolidchain/abis": "workspace:*",
    "@thesolidchain/address-book-common": "workspace:*",
    "@thesolidchain/deployment-types": "workspace:*",
    "@thesolidchain/deployment-utils": "workspace:*",
    "@thesolidchain/oracle-common": "workspace:*",
    "@thesolidchain/protocol-plugins-common": "workspace:*",
    "@thesolidchain/sdk-common": "workspace:*",
    "@thesolidchain/swap-common": "workspace:*",
    "@thesolidchain/testing-utils": "workspace:*",
    "@thesolidchain/tokens-common": "workspace:*",
    "bignumber.js": "^9.3.1",
    "viem": "2.43.5",
    "zod": "3.25.61"
  },
  "devDependencies": {
    "@thesolidchain/config-typescript": "workspace:*",
    "@thesolidchain/eslint-config": "workspace:*",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}
