{
  "name": "@thesolidchain/tenderly-utils",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "tsc -w",
    "test": "vitest run tests/",
    "testw": "vitest watch",
    "e2e": "vitest run e2e/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -b --preserveWatchOutput -v tsconfig.build.json",
    "dev": "tsc -b --preserveWatchOutput tsconfig.build.json  -w"
  },
  "dependencies": {
    "@inquirer/prompts": "^4.3.3",
    "@thesolidchain/configuration-provider": "workspace:*",
    "@thesolidchain/configuration-provider-common": "workspace:*",
    "@thesolidchain/sdk-common": "workspace:*",
    "@thesolidchain/testing-utils": "workspace:*",
    "typescript": "^5.7.3",
    "viem": "2.43.5"
  },
  "devDependencies": {
    "@ethersproject/providers": "^5.7.2",
    "@thesolidchain/eslint-config": "workspace:*",
    "@thesolidchain/config-typescript": "workspace:*",
    "axios": "^1.8.4",
    "ethers": "^6.11.1",
    "@thesolidchain/config-vitest": "workspace:*",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}
