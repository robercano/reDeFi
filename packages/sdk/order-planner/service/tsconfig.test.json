{
  "extends": "@thesolidchain/config-typescript/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@thesolidchain/order-planner-common/*": [
        "node_modules/@thesolidchain/order-planner-common/src/*"
      ],
      "@thesolidchain/order-planner-common": [
        "node_modules/@thesolidchain/order-planner-common/src/index.ts"
      ],
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/abis": ["../../packages/abis/src/index.ts"],
      "@thesolidchain/contracts-core": ["node_modules/@thesolidchain/contracts-core/src/index.ts"],
      "@thesolidchain/swap-common/*": ["node_modules/@thesolidchain/swap-common/src/*"],
      "@thesolidchain/deployment-utils": [
        "node_modules/@thesolidchain/deployment-utils/src/index.ts"
      ],
      "@thesolidchain/blockchain-client-provider": [
        "../../blockchain-client/provider/src/index.ts"
      ],
      "@thesolidchain/protocol-plugins": ["../../protocol-plugins/service/service/src/index.ts"],
      "@thesolidchain/protocol-plugins/*": ["node_modules/@thesolidchain/protocol-plugins/src/*"],
      "@thesolidchain/protocol-plugins-common": [
        "node_modules/@thesolidchain/protocol-plugins-common/src/index.ts"
      ],
      "@thesolidchain/testing-utils": ["node_modules/@thesolidchain/testing-utils/src/index.ts"],
      "@thesolidchain/oracle-common": ["../../oracle/common/src/index.ts"],
      "@thesolidchain/tokens-common": ["../../tokens/common/src/index.ts"],
      "@thesolidchain/api-server-common": ["../../sdk-server/service/service-common/src/index.ts"],
      "@thesolidchain/tokens-service": ["../../tokens/service/src/index.ts"],
      "@thesolidchain/serverless-shared": ["../../packages/serverless-shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
