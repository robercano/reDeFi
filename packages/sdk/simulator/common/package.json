{
  "name": "@thesolidchain/simulator-common",
  "version": "0.0.1",
  "exports": {
    ".": {
      "require": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "tsc -w",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -b --preserveWatchOutput -v tsconfig.build.json",
    "bundle": "esbuild src/index.ts --bundle --minify --platform=node --target=node20 --outfile=dist/index.js --sourcemap"
  },
  "dependencies": {
    "@thesolidchain/sdk-common": "workspace:*"
  },
  "devDependencies": {
    "@thesolidchain/eslint-config": "workspace:*",
    "@thesolidchain/config-typescript": "workspace:*",
    "@thesolidchain/config-vitest": "workspace:*",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}
