{
  "extends": "@thesolidchain/config-typescript/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": "src",
    "paths": {
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/swap-common/*": ["node_modules/@thesolidchain/swap-common/src/*"],
      "@thesolidchain/protocol-plugins/*": ["node_modules/@thesolidchain/protocol-plugins/src/*"],
      "@thesolidchain/protocol-plugins": [
        "node_modules/@thesolidchain/protocol-plugins/src/index.ts"
      ],
      "@thesolidchain/protocol-plugins-common": [
        "node_modules/@thesolidchain/protocol-plugins-common/src/index.ts"
      ],
      "@thesolidchain/abis": ["../../packages/abis/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
