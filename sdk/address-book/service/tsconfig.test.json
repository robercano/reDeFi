{
  "extends": "@thesolidchain/typescript-config/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/sdk-client": ["../sdk-client/src"],

      "@thesolidchain/swap-common/*": ["node_modules/@thesolidchain/swap-common/src/*"],
      "@thesolidchain/common": ["node_modules/@thesolidchain/common/src/index.ts"],
      "@thesolidchain/configuration-provider": [
        "node_modules/@thesolidchain/configuration-provider/src/index.ts"
      ],
      "@thesolidchain/core-contracts": ["node_modules/@thesolidchain/core-contracts/src/index.ts"],
      "@thesolidchain/deployment-utils": ["node_modules/@thesolidchain/deployment-utils/src/index.ts"],
      "@thesolidchain/hardhat-utils": ["../../packages/hardhat-utils/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
