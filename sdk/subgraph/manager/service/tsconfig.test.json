{
  "extends": "@thesolidchain/typescript-config/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/sdk-server-common": ["node_modules/@thesolidchain/sdk-server-common/src/index.ts"],
      "@thesolidchain/serverless-shared": ["../../packages/serverless-shared/src/index.ts"],
      "@thesolidchain/testing-utils/*": ["node_modules/@thesolidchain/testing-utils/src/*"],
      "@thesolidchain/configuration-provider": [
        "node_modules/@thesolidchain/configuration-provider/src/index.ts"
      ],
      "@thesolidchain/subgraph-manager-common": [
        "node_modules/@thesolidchain/subgraph-manager-common/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
