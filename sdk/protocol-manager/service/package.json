{
  "name": "@thesolidchain/protocol-manager-service",
  "version": "0.0.1",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "tsc -w",
    "test": "jest --coverage=true",
    "testw": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -b --preserveWatchOutput -v tsconfig.build.json",
    "bundle": "esbuild src/index.ts --bundle --minify --platform=node --target=node20 --outfile=dist/index.js --sourcemap"
  },
  "dependencies": {
    "@thesolidchain/deployment-types": "workspace:*",
    "@thesolidchain/sdk-common": "workspace:*",
    "@thesolidchain/protocol-manager-common": "workspace:*",
    "@thesolidchain/protocol-plugins": "workspace:*",
    "@thesolidchain/protocol-plugins-common": "workspace:*",
    "@types/node-fetch": "^2.6.11"
  },
  "devDependencies": {
    "@thesolidchain/eslint-config": "workspace:*",
    "@thesolidchain/jest-config": "workspace:*",
    "@thesolidchain/typescript-config": "workspace:*",
    "@thesolidchain/order-planner-common": "workspace:*"
  }
}
