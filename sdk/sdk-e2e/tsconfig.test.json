{
  "extends": "@thesolidchain/typescript-config/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/sdk-client": ["node_modules/@thesolidchain/sdk-client/src"],
      "@thesolidchain/protocol-manager-service": [
        "node_modules/@thesolidchain/protocol-manager-service/src/index.ts"
      ],
      "@thesolidchain/protocol-plugins/*": ["node_modules/@thesolidchain/protocol-plugins/src/*"],
      "@thesolidchain/protocol-plugins": ["node_modules/@thesolidchain/protocol-plugins/src/index.ts"],
      "@thesolidchain/protocol-plugins-common": [
        "node_modules/@thesolidchain/protocol-plugins-common/src/index.ts"
      ],
      "@thesolidchain/testing-utils": ["node_modules/@thesolidchain/testing-utils/src/index.ts"],
      "@thesolidchain/core-contracts": ["node_modules/@thesolidchain/core-contracts/src/index.ts"],
      "@thesolidchain/deployment-utils": ["node_modules/@thesolidchain/deployment-utils/src/index.ts"],
      "@thesolidchain/abis": ["../../packages/abis/src/index.ts"],
      "@thesolidchain/sdk-server-common": ["../sdk-server/service/service-common/src/index.ts"],
      "@thesolidchain/tokens-service": ["../tokens/service/src/index.ts"],
      "@thesolidchain/tenderly-utils": ["../tenderly-utils/src/index.ts"],
      "@thesolidchain/serverless-shared": ["../../packages/serverless-shared/src/index.ts"],
      "@thesolidchain/blockchain-client-provider": ["../blockchain-client/provider/src/index.ts"],
      "@thesolidchain/contracts-provider-service": ["../contracts-provider/service/src/index.ts"],
      "@thesolidchain/contracts-provider-common": ["../contracts-provider/common/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
