{
  "private": true,
  "scripts": {
    "dev": "turbo run dev --concurrency=100",
    "prebuild": "turbo run prebuild --cache-dir=.turbo",
    "build": "turbo run build --cache-dir=.turbo",
    "prebuild:sdk": "turbo run prebuild --cache-dir=.turbo --filter=./sdk/*",
    "build:sdk": "turbo run build --cache-dir=.turbo --filter=./sdk/*",
    "test:sdk": "turbo run test --cache-dir=.turbo --filter=./sdk/*",
    "lint:sdk": "turbo run lint --cache-dir=.turbo --filter=./sdk/*",
    "sst:sdk": "cd sdk && pnpm run sst:dev",
    "lint": "turbo run lint --cache-dir=.turbo",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test --cache-dir=.turbo",
    "test:integration": "turbo run test:integration --cache-dir=.turbo",
    "check-circular": "turbo run check-circular --cache-dir=.turbo",
    "db:migrate": "turbo run db:migrate --cache-dir=.turbo",
    "cicheck": "turbo run cicheck --cache-dir=.turbo --filter=./packages/* --filter=./external-api/* && pnpm run coverage:total",
    "cicheck:dev": "turbo run cicheck --cache-dir=.turbo --output-logs=new-only --concurrency=100% --continue",
    "format": "prettier --log-level=error --cache --cache-strategy metadata --cache-location=.turbo/prettier --check \"./**/*.{ts,tsx,js,jsx,json}\"",
    "format:fix": "prettier --write --log-level=error --cache --cache-strategy metadata --cache-location=.turbo/prettier-fix \"./**/*.{ts,tsx,js,jsx,json}\"",
    "coverage:total": "node scripts/coverage-report/GenerateCoverageReport.js"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.732.0",
    "@graphql-codegen/add": "^5.0.2",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typed-document-node": "^5.0.6",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@thesolidchain/eslint-config": "workspace:*",
    "@thesolidchain/typescript-config": "workspace:*",
    "@tsconfig/node20": "^20.1.4",
    "@turbo/gen": "^2.0.6",
    "@types/aws-lambda": "^8.10.137",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "aws-cdk-lib": "2.132.1",
    "constructs": "10.3.0",
    "create-ts-index": "^1.14.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "esbuild": "^0.25.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "jest-extended": "^4.0.2",
    "madge": "^7.0.0",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "sst": "2.41.5",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.16.5",
    "turbo": "^2.5.5",
    "typescript": "^5.7.3",
    "zx": "^8.3.0"
  },
  "name": "redefi",
  "packageManager": "pnpm@8.15.9+sha256.daa27a0b541bc635323ff96c2ded995467ff9fe6d69ff67021558aa9ad9dcc36",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.3",
      "@walletconnect/logger": "3.0.2",
      "react-is": "19.1.0",
      "graphql": "16.11.0"
    }
  }
}
