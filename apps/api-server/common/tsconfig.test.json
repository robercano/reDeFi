{
  "extends": "@thesolidchain/config-typescript/tsconfig.test.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowJs": true,
    "paths": {
      "@thesolidchain/common": ["node_modules/@thesolidchain/common/src/index.ts"],
      "@thesolidchain/sdk-common/*": ["node_modules/@thesolidchain/sdk-common/src/*"],
      "@thesolidchain/sdk-common": ["node_modules/@thesolidchain/sdk-common/src/index.ts"],
      "@thesolidchain/swap-service": ["node_modules/@thesolidchain/swap-service/src/index.ts"],
      "@thesolidchain/swap-common/*": ["node_modules/@thesolidchain/swap-common/src/*"],
      "@thesolidchain/testing-utils/*": ["../testing-utils/src/*"],
      "@thesolidchain/configuration-provider-common": [
        "node_modules/@thesolidchain/configuration-provider-common/src/index.ts"
      ],
      "@thesolidchain/configuration-provider-mock": [
        "node_modules/@thesolidchain/configuration-provider-mock/src/index.ts"
      ],
      "@thesolidchain/configuration-provider": [
        "../../configuration-provider/service/service/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
