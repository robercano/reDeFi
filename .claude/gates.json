{
  "_README": "PROJECT ADAPTER. This is the ONLY file you must fill in per project. The generic agents/hooks read it. Leave a value as an empty string to mark a gate 'not configured' (it will be skipped, not failed). See docs/GETTING_STARTED.md and docs/PROMPTS.md.",

  "project": {
    "name": "reDeFi",
    "language": "TypeScript",
    "packageManager": "pnpm"
  },

  "modules": [
    { "name": "api-authorizer", "path": "apps/api-authorizer", "description": "Lambda authorizer for the API gateway.", "owner": "" },
    { "name": "api-router", "path": "apps/api-router", "description": "API routing layer service.", "owner": "" },
    { "name": "api-server", "path": "apps/api-server", "description": "Serverless API backend for the SDK/protocol.", "owner": "" },
    { "name": "jobs", "path": "apps/jobs", "description": "Scheduled/background job workers.", "owner": "" },
    { "name": "sdk-demo", "path": "apps/sdk-demo", "description": "Demo app exercising the SDK.", "owner": "" },
    { "name": "sdk-infra", "path": "apps/sdk-infra", "description": "SST infrastructure/deployment app for the SDK backend.", "owner": "" },

    { "name": "abis", "path": "packages/abis", "description": "Smart contract ABI definitions.", "owner": "" },
    { "name": "common", "path": "packages/common", "description": "Shared utilities used across apps/packages.", "owner": "" },
    { "name": "config", "path": "packages/config", "description": "Shared eslint/jest/typescript/vitest configs.", "owner": "" },
    { "name": "deployment-types", "path": "packages/deployment-types", "description": "Shared types for contract deployment tooling.", "owner": "" },
    { "name": "deployment-utils", "path": "packages/deployment-utils", "description": "Contract deployment utility functions.", "owner": "" },
    { "name": "hardhat-utils", "path": "packages/hardhat-utils", "description": "Hardhat tooling helpers for contract development.", "owner": "" },
    { "name": "serverless-shared", "path": "packages/serverless-shared", "description": "Shared code for serverless apps (api-server, api-router, jobs).", "owner": "" },
    { "name": "ui", "path": "packages/ui", "description": "Shared React UI component library.", "owner": "" },

    { "name": "sdk-abi-provider", "path": "packages/sdk/abi-provider", "description": "SDK service resolving contract ABIs.", "owner": "" },
    { "name": "sdk-address-book", "path": "packages/sdk/address-book", "description": "SDK service for known contract/token addresses.", "owner": "" },
    { "name": "sdk-allowance-manager", "path": "packages/sdk/allowance-manager", "description": "SDK service managing ERC20 allowances.", "owner": "" },
    { "name": "sdk-blockchain-client", "path": "packages/sdk/blockchain-client", "description": "SDK low-level blockchain RPC client.", "owner": "" },
    { "name": "sdk-client", "path": "packages/sdk/client", "description": "SDK top-level client entrypoint.", "owner": "" },
    { "name": "sdk-common", "path": "packages/sdk/common", "description": "Shared types/utilities across SDK packages.", "owner": "" },
    { "name": "sdk-configuration-provider", "path": "packages/sdk/configuration-provider", "description": "SDK runtime configuration provider.", "owner": "" },
    { "name": "sdk-contracts-provider", "path": "packages/sdk/contracts-provider", "description": "SDK service resolving contract instances.", "owner": "" },
    { "name": "sdk-e2e", "path": "packages/sdk/e2e", "description": "SDK end-to-end tests (live chain forks, needs secrets).", "owner": "" },
    { "name": "sdk-events", "path": "packages/sdk/events", "description": "SDK on-chain event subscription/parsing service.", "owner": "" },
    { "name": "sdk-oracle", "path": "packages/sdk/oracle", "description": "SDK price oracle service.", "owner": "" },
    { "name": "sdk-order-planner", "path": "packages/sdk/order-planner", "description": "SDK order planning/routing engine.", "owner": "" },
    { "name": "sdk-portfolio", "path": "packages/sdk/portfolio", "description": "SDK portfolio/position tracking service.", "owner": "" },
    { "name": "sdk-protocol-manager", "path": "packages/sdk/protocol-manager", "description": "SDK service managing protocol plugin lifecycle.", "owner": "" },
    { "name": "sdk-protocol-plugins", "path": "packages/sdk/protocol-plugins", "description": "SDK per-protocol integration plugins (e.g. Yearn).", "owner": "" },
    { "name": "sdk-react", "path": "packages/sdk/react", "description": "SDK React hooks/bindings.", "owner": "" },
    { "name": "sdk-router", "path": "packages/sdk/router", "description": "SDK swap/order routing logic.", "owner": "" },
    { "name": "sdk-subscriptions", "path": "packages/sdk/subscriptions", "description": "SDK subscription/streaming update service.", "owner": "" },
    { "name": "sdk-swap", "path": "packages/sdk/swap", "description": "SDK swap execution service.", "owner": "" },
    { "name": "sdk-tenderly-utils", "path": "packages/sdk/tenderly-utils", "description": "SDK Tenderly simulation/fork utilities.", "owner": "" },
    { "name": "sdk-testing-utils", "path": "packages/sdk/testing-utils", "description": "SDK shared testing utilities.", "owner": "" },
    { "name": "sdk-tokens", "path": "packages/sdk/tokens", "description": "SDK token metadata/list service.", "owner": "" },
    { "name": "sdk-tools", "path": "packages/sdk/tools", "description": "SDK misc developer tooling.", "owner": "" },

    { "name": "docs", "path": "docs", "description": "Project and SDK documentation.", "owner": "" }
  ],

  "gates": {
    "_note": "Exact shell commands for this repo. Run from repo root. Empty string = skip.",
    "install": "pnpm install --frozen-lockfile",
    "build": "pnpm run build",
    "lint": "pnpm run lint",
    "typecheck": "",
    "test": "pnpm run test",
    "test_affected": "pnpm run test",
    "coverage": "pnpm run test && pnpm run coverage:total",
    "coverage_threshold": 80,
    "e2e": "",
    "security": ""
  },

  "worktree": {
    "_note": "Optional per-worktree lifecycle. `setup` runs right after an isolated implementer/reviewer worktree is created — bootstrap toolchain state that lives OUTSIDE the tree so every gate is runnable in-worktree (e.g. 'pnpm install', 'forge install', link shared caches). `teardown` runs before the worktree is removed. Empty string = skip. Run via .claude/scripts/worktree.sh setup|teardown.",
    "setup": "",
    "teardown": ""
  },

  "review": {
    "lenses": ["correctness", "tests", "security", "performance"],
    "consensus": "all",
    "_consensus_note": "'all' = every lens must approve; or an integer = that many approvals required.",
    "skills": []
  },

  "budget": {
    "orchestrator_model": "opus",
    "worker_model": "sonnet",
    "explorer_model": "haiku",
    "reviewer_model": "opus",
    "reviewer_models": {},
    "max_parallel_workers": 3,
    "_note": "Opus to coordinate, Sonnet to build, Haiku to explore. Reviews route per lens via reviewer_models (fallback: reviewer_model) — keep Opus for the lenses where misses are expensive (correctness, security), Sonnet for the rest. Every +1 max_parallel_workers multiplies token burn AND your review load; raise it only when review/merge is not the bottleneck."
  },

  "merge": {
    "policy": "pr-per-agent",
    "_policy_options": "pr-per-agent | orchestrated-sequential-merge",
    "baseBranch": "main"
  }
}
